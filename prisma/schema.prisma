generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  completed
}

enum PayoutStatus {
  pending
  paid
}

enum PropertyType {
  villa
  apartment
  farmstay
  cottage
  bungalow
  homestay
}

enum ListingStatus {
  pending_review
  active
  rejected
}

model Owner {
  id                String     @id @default(cuid())
  fullName          String     @map("full_name")
  email             String     @unique
  phone             String
  passwordHash      String     @map("password_hash")
  pan               String
  gstin             String?
  bankAccountName   String     @map("bank_account_name")
  bankAccountNumber String     @map("bank_account_number")
  bankIfsc          String     @map("bank_ifsc")
  bankName          String     @map("bank_name")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  properties        Property[]

  @@map("owners")
}

model Property {
  id                String        @id @default(cuid())
  ownerId           String?       @map("owner_id")
  owner             Owner?        @relation(fields: [ownerId], references: [id])
  name              String
  address           String
  city              String
  pincode           String        @default("")
  landmark          String?
  description       String
  houseRules        String        @default("") @map("house_rules")
  amenities         String[]
  propertyType      PropertyType  @default(homestay) @map("property_type")
  listingStatus     ListingStatus @default(active) @map("listing_status")
  maxGuests         Int           @default(2) @map("max_guests")
  bedrooms          Int           @default(1)
  beds              Int           @default(1)
  bathrooms         Int           @default(1)
  checkInTime       String        @default("14:00") @map("check_in_time")
  checkOutTime      String        @default("11:00") @map("check_out_time")
  minNights         Int           @default(1) @map("min_nights")
  basePricePerNight Int           @map("base_price_per_night")
  photos            String[]
  active            Boolean       @default(true)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  bookings          Booking[]

  @@map("properties")
}

model Booking {
  id          String        @id @default(cuid())
  propertyId  String        @map("property_id")
  property    Property      @relation(fields: [propertyId], references: [id])
  guestName   String        @map("guest_name")
  guestEmail  String        @map("guest_email")
  guestPhone  String        @map("guest_phone")
  checkIn     DateTime      @map("check_in") @db.Date
  checkOut    DateTime      @map("check_out") @db.Date
  status      BookingStatus @default(pending)
  totalAmount Int           @map("total_amount")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  ledger      Ledger[]

  @@map("bookings")
}

model Ledger {
  id                 String       @id @default(cuid())
  bookingId          String       @map("booking_id")
  booking            Booking      @relation(fields: [bookingId], references: [id])
  totalAmount        Int          @map("total_amount")
  platformCommission Int          @map("platform_commission")
  ownerPayout        Int          @map("owner_payout")
  currency           String       @default("INR")
  payoutStatus       PayoutStatus @default(pending) @map("payout_status")
  createdAt          DateTime     @default(now()) @map("created_at")

  @@map("ledger")
}
