# Local Docker: postgresql://postgres:postgres@localhost:5432/travel_booking
# On Vercel / Supabase, use the pooler URL (port 6543, pgbouncer=true).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/travel_booking"

# Supabase session pooler (port 5432). Used for prisma migrate / seed.
# DIRECT_URL="postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"

# Signed cookie for the owner portal. Replace before any real deploy.
# Auth will move to Supabase later. Also set this on Vercel.
OWNER_SESSION_SECRET="replace-with-a-long-random-string"

# Password for /admin. Set this on Vercel too. Do not share it with owners.
ADMIN_PASSWORD="replace-with-a-long-random-string"
